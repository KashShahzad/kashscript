{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kashscript.com/lexicons/kash.trust-list@1.1.0",
  "title": "A trust list",
  "description": "kash.trust-list@1.0.0 with the publisher's self-certifying key written in either spelling (RW-19 B, d97(h)): did:kash or did:key — never a did:web, so the list's own signature checks from the identifier alone. A 1.0.0 body is a 1.1.0 body.",
  "type": "object",
  "properties": {
    "format": {
      "const": "kashscript-trust-list/1"
    },
    "listId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "publisher": {
      "type": "string",
      "pattern": "^(?:did:kash:[1-9A-HJ-NP-Za-km-z]{32,48}|did:key:z[1-9A-HJ-NP-Za-km-z]{40,60})$"
    },
    "issuedAtUnix": {
      "type": "integer",
      "minimum": 0
    },
    "validFromUnix": {
      "type": "integer",
      "minimum": 0
    },
    "validUntilUnix": {
      "type": "integer",
      "minimum": 0
    },
    "floor": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "version"
      ]
    },
    "issuers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issuerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "keyid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "alg": {
                  "enum": [
                    "Ed25519",
                    "ES256"
                  ]
                },
                "publicKeyHex": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{64}|0[23][0-9a-f]{64})$"
                }
              },
              "additionalProperties": false,
              "required": [
                "keyid",
                "alg",
                "publicKeyHex"
              ]
            },
            "maxItems": 16
          },
          "dsts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 1,
            "maxItems": 64
          },
          "validFromUnix": {
            "type": "integer",
            "minimum": 0
          },
          "validUntilUnix": {
            "type": "integer",
            "minimum": 0
          },
          "class": {
            "enum": [
              "self-issuer",
              "counterparty",
              "assessor",
              "accredited-body",
              "insurer"
            ]
          },
          "standing": {
            "enum": [
              "listed",
              "suspended",
              "removed"
            ]
          },
          "grade": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false,
              "required": [
                "id"
              ]
            },
            "minItems": 1,
            "maxItems": 64
          },
          "floor": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false,
            "required": [
              "version"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "issuerId",
          "label",
          "keys",
          "dsts",
          "validFromUnix",
          "validUntilUnix",
          "class",
          "standing"
        ]
      },
      "maxItems": 4096
    },
    "practice": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "listId",
    "version",
    "publisher",
    "issuedAtUnix",
    "validFromUnix",
    "validUntilUnix",
    "floor",
    "issuers"
  ]
}
