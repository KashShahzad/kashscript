{
  "name": "@kashscript/whiffin",
  "version": "0.2.1",
  "description": "The mandate protocol — purpose-bound mandates (W3C VC, AP2 semantics). It never moves money.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".":               "./src/index.ts",
    "./mandate":       "./src/mandate/index.ts",
    "./policy":        "./src/policy.ts",
    "./credential":    "./src/credential.ts",
    "./rails":         "./src/rails/index.ts",
    "./report":        "./src/report/index.ts"
  },
  "dependencies": {
    "@kashscript/identity-core": "workspace:*",
    "@kashscript/identity-zkp": "workspace:*",
    "@kashscript/attest": "workspace:*"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build":          "tsc -p tsconfig.json",
    "typecheck":      "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test":           "bun run typecheck:test && bun test",
    "clean":          "rm -rf dist .turbo"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/bun": "^1.2.5"
  },
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/KashShahzad/kashscript.git", "directory": "packages/whiffin" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
