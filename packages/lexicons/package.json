{
  "name": "@kashscript/lexicons",
  "version": "0.4.0-alpha.0",
  "description": "Zero-dependency lexicon framework — envelope, schema DSL, registry, validator. Agnostic core; domain content ships as opt-in extensions.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".":                      "./src/index.ts",
    "./envelope":             "./src/envelope.ts",
    "./schema":               "./src/schema.ts",
    "./registry":             "./src/registry.ts",
    "./engine":               "./src/engine.ts",
    "./json-schema":          "./src/json-schema.ts",
    "./semver":               "./src/semver.ts",
    "./extensions/social":    "./src/extensions/social.ts",
    "./extensions/trade":     "./src/extensions/trade.ts",
    "./extensions/zkp":       "./src/extensions/zkp.ts",
    "./extensions/education": "./src/extensions/education.ts",
    "./extensions/civic":     "./src/extensions/civic.ts",
    "./extensions/community": "./src/extensions/community.ts",
    "./extensions/door":      "./src/extensions/door.ts"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build":          "tsc -p tsconfig.json",
    "typecheck":      "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test":           "bun run typecheck:test && bun test",
    "clean":          "rm -rf dist .turbo"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/bun": "^1.2.5"
  },
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/KashShahzad/kashscript.git", "directory": "packages/lexicons" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
