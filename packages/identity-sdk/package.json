{
  "name": "@kashscript/identity-sdk",
  "version": "0.1.4",
  "description": "React SDK for did:kash — WebAuthn (Passkey) bridge, KashAuthProvider, and headless hooks for the Kash Identity Foundry.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".":                  "./src/index.ts",
    "./provider":         "./src/provider.tsx",
    "./hooks":            "./src/hooks.ts",
    "./webauthn":         "./src/webauthn.ts",
    "./storage":          "./src/storage.ts",
    "./storage-adapter":  "./src/storage-adapter.ts",
    "./recovery":         "./src/recovery.ts",
    "./rotation":         "./src/rotation.ts",
    "./revocation":       "./src/revocation.ts",
    "./errors":           "./src/errors.ts",
    "./ui":               "./src/ui/index.ts"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build":          "tsc -p tsconfig.json",
    "typecheck":      "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test":           "bun run typecheck:test && bun test use-cases",
    "clean":          "rm -rf dist .turbo"
  },
  "dependencies": {
    "@kashscript/identity-core": "workspace:*"
  },
  "peerDependencies": {
    "react":     "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@kashscript/lexicons": "workspace:*",
    "@types/bun":       "^1.2.5",
    "@types/react":     "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react":            "^19.0.0",
    "react-dom":        "^19.0.0",
    "typescript":       "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/KashShahzad/kashscript.git", "directory": "packages/identity-sdk" },
  "publishConfig": {
    "access":   "public",
    "registry": "https://registry.npmjs.org/",
    "main":     "./dist/index.js",
    "types":    "./dist/index.d.ts",
    "exports": {
      ".":                 { "types": "./dist/index.d.ts",            "import": "./dist/index.js" },
      "./provider":        { "types": "./dist/provider.d.ts",         "import": "./dist/provider.js" },
      "./hooks":           { "types": "./dist/hooks.d.ts",            "import": "./dist/hooks.js" },
      "./webauthn":        { "types": "./dist/webauthn.d.ts",         "import": "./dist/webauthn.js" },
      "./storage":         { "types": "./dist/storage.d.ts",          "import": "./dist/storage.js" },
      "./storage-adapter": { "types": "./dist/storage-adapter.d.ts",  "import": "./dist/storage-adapter.js" },
      "./recovery":        { "types": "./dist/recovery.d.ts",         "import": "./dist/recovery.js" },
      "./rotation":        { "types": "./dist/rotation.d.ts",         "import": "./dist/rotation.js" },
      "./revocation":      { "types": "./dist/revocation.d.ts",       "import": "./dist/revocation.js" },
      "./errors":          { "types": "./dist/errors.d.ts",           "import": "./dist/errors.js" },
      "./ui":              { "types": "./dist/ui/index.d.ts",         "import": "./dist/ui/index.js" }
    }
  }
}
