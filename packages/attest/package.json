{
  "name": "@kashscript/attest",
  "version": "0.2.0-alpha.10",
  "description": "The Evidence Commons — JCS + Ed25519, DSSE/PAE envelopes, a canonical DST registry, Rekor/OpenTimestamps witnessing, hash-chains, a standalone verifier CLI, and offline compat verifiers for the KashScript ecosystem's signed artifacts. Apache-2.0 — verification is free.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".":         "./src/index.ts",
    "./errors":  "./src/errors.ts",
    "./ed25519": "./src/ed25519.ts",
    "./dsse":    "./src/dsse.ts",
    "./dst":     "./src/dst.ts",
    "./chain":   "./src/chain.ts",
    "./ids":     "./src/ids.ts",
    "./witness": "./src/witness/index.ts",
    "./ledger":  "./src/ledger.ts",
    "./bundle":  "./src/bundle.ts",
    "./countersign": "./src/countersign.ts",
    "./succession": "./src/succession.ts",
    "./signing": "./src/signing.ts",
    "./holder":  "./src/holder/index.ts",
    "./sd-jwt":  "./src/sd-jwt/index.ts",
    "./exchange": "./src/exchange/index.ts",
    "./profiles": "./src/profiles/index.ts",
    "./compat":  "./src/compat/index.ts"
  },
  "bin": {
    "attest": "./src/bin/attest.ts"
  },
  "dependencies": {
    "@kashscript/identity-core": "workspace:*"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build":          "tsc -p tsconfig.json && bun run build:bin",
    "build:bin":      "bun scripts/bundle-bin.ts",
    "typecheck":      "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test":           "bun run typecheck:test && bun test",
    "clean":          "rm -rf dist .turbo"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/bun": "^1.2.5"
  },
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/KashShahzad/kashscript.git", "directory": "packages/attest" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "bin": {
      "attest": "./dist/bin/attest.js"
    }
  }
}
